# Required for live odds and closing-line collection
ODDS_API_KEY=

# Optional supplemental collector
SPORTSDATAIO_API_KEY=

# The pipeline logs decisions and bets but does not place wagers automatically.
# Keep paper mode until the forward validation gates pass.
BETTING_EXECUTION_MODE=paper

# The Odds API bookmaker keys you can actually access, comma-separated.
# Empty in paper mode means line-shop across every quoted book. Required in live mode.
BETTING_BOOKMAKERS=
